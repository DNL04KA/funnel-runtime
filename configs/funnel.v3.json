                ]
              },
              "goto": "budget",
              "label": "Крупный поток → спрашиваем бюджет"
            },
            {
              "if": {
                "any": [
                  {
                    "field": "volume",
                    "op": "eq",
                    "value": "enterprise"
                  },
                  {
                    "field": "integrations",
                    "op": "includes",
                    "value": [
                      "legacy"
                    ]
                  }
                ]
              },
              "goto": "sla",
              "label": "НОВАЯ ВЕТКА: legacy-интеграция → экран регламента"
