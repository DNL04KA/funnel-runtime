                      "legacy"
                    ]
                  }
                ]
              },
              "goto": "sla",
              "label": "НОВАЯ ВЕТКА: enterprise или legacy → экран регламента"
            },
            {
              "goto": "result"
            }
          ]
        },
        "result": {
          "title": "Готово — предлагаем следующий шаг",
