{
  "funnelId": "sorter-wms-fit",
  "name": "Sorter WMS — подбор решения (v1, baseline)",
  "schemaVersion": 1,
  "start": "intro",
  "theme": { "accent": "#4f46e5", "accentSoft": "#eef2ff" },
  "experiment": {
    "key": "exp_result_cta_v1",
    "variants": ["A", "B"],
    "split": { "A": 0.5, "B": 0.5 },
    "hypothesis": "Вариант A завершает воронку расчётом стоимости («Получить расчёт»), вариант B — живым демо («Записаться на демо»). Гипотеза: обещание конкретной цифры снижает воспринимаемый риск сильнее, чем обещание встречи, поэтому A даёт более высокий CTR основного CTA без потери конверсии в результат.",
    "primaryMetric": "cta_ctr"
  },
  "steps": [
    {
      "id": "intro",
      "type": "info",
      "title": "Подберём конфигурацию Sorter WMS",
      "subtitle": "Шесть вопросов, примерно полторы минуты",
      "body": [
        "Sorter WMS — вымышленная система управления складом из тестового задания.",
        "По ответам мы соберём профиль склада и покажем подходящий тариф с оценкой сроков внедрения."
      ],
      "ctaLabel": "Начать подбор",
      "next": "role"
    },
    {
      "id": "role",
      "type": "single_select",
      "title": "Какая у вас роль в проекте?",
      "subtitle": "От этого зависит, о чём спросим дальше",
      "field": "role",
      "required": true,
      "options": [
        { "value": "owner", "label": "Собственник или директор", "hint": "Смотрю на экономику и сроки", "trafficWeight": 3 },
        { "value": "ops", "label": "Руководитель склада или логистики", "hint": "Отвечаю за операции", "trafficWeight": 4 },
        { "value": "it", "label": "ИТ-директор или архитектор", "hint": "Отвечаю за интеграции и данные", "trafficWeight": 3 }
      ],
      "next": [
        {
          "if": { "field": "role", "op": "eq", "value": "it" },
          "goto": "integrations",
          "label": "ИТ-роль → ветка интеграций"
        },
        { "goto": "warehouses", "label": "Бизнес-роль → ветка операций" }
      ]
    },
    {
      "id": "warehouses",
      "type": "number",
      "title": "Сколько складов нужно подключить?",
      "subtitle": "Считайте все площадки, включая кросс-докинг",
      "field": "warehouses",
      "min": 1,
      "max": 120,
      "stepSize": 1,
      "unit": "скл.",
      "placeholder": "например, 3",
      "required": true,
      "buckets": [1, 2, 4, 11, 26],
      "next": "volume"
    },
    {
      "id": "integrations",
      "type": "multi_select",
      "title": "Какие системы нужно интегрировать?",
      "subtitle": "Выберите от одной до четырёх",
      "field": "integrations",
      "minSelected": 1,
      "maxSelected": 4,
      "options": [
        { "value": "erp", "label": "ERP / учётная система", "trafficWeight": 5 },
        { "value": "marketplaces", "label": "Маркетплейсы", "trafficWeight": 4 },
        { "value": "crm", "label": "CRM", "trafficWeight": 2 },
        { "value": "tms", "label": "TMS / транспорт", "trafficWeight": 3 },
        { "value": "legacy", "label": "Собственная legacy-система", "trafficWeight": 2 },
        { "value": "none", "label": "Пока ничего, нужен автономный контур", "trafficWeight": 1 }
      ],
      "next": "volume"
    },
    {
      "id": "volume",
      "type": "single_select",
      "title": "Сколько заказов обрабатываете в сутки?",
      "field": "volume",
      "required": true,
      "options": [
        { "value": "upto_500", "label": "До 500", "trafficWeight": 4 },
        { "value": "500_5k", "label": "От 500 до 5 000", "trafficWeight": 5 },
        { "value": "5k_50k", "label": "От 5 000 до 50 000", "trafficWeight": 3 },
        { "value": "enterprise", "label": "Более 50 000", "trafficWeight": 1 }
      ],
      "next": "features"
    },
    {
      "id": "features",
      "type": "multi_select",
      "title": "Что важнее всего закрыть в первую очередь?",
      "subtitle": "Выберите от двух до четырёх пунктов",
      "field": "features",
      "minSelected": 2,
      "maxSelected": 4,
      "options": [
        { "value": "picking", "label": "Оптимизация сборки заказов", "trafficWeight": 5 },
        { "value": "inventory", "label": "Инвентаризация и остатки", "trafficWeight": 4 },
        { "value": "labor", "label": "Планирование смен и KPI персонала", "trafficWeight": 3 },
        { "value": "returns", "label": "Обработка возвратов", "trafficWeight": 3 },
        { "value": "analytics", "label": "Аналитика и отчётность", "trafficWeight": 4 },
        { "value": "wms_mobile", "label": "Мобильные терминалы сборщиков", "trafficWeight": 3 }
      ],
      "next": "result"
    },
    {
      "id": "result",
      "type": "result",
      "title": "Готово — вот что мы подобрали",
      "ctaLabel": "Получить расчёт стоимости",
      "ctaHref": "#/cta/quote",
      "secondaryCtaLabel": "Скачать описание тарифа",
      "outcomes": [
        {
          "id": "enterprise",
          "if": { "field": "volume", "op": "in", "value": ["5k_50k", "enterprise"] },
          "headline": "Sorter WMS Enterprise",
          "body": [
            "При таком потоке заказов нужен выделенный контур, кластерная установка и SLA 99,95%.",
            "Внедрение ведёт отдельная команда, первый склад запускаем за 10–14 недель."
          ],
          "highlights": [
            { "label": "Тариф", "value": "Enterprise" },
            { "label": "Срок внедрения", "value": "10–14 недель" },
            { "label": "Модель поставки", "value": "Выделенный контур" }
          ]
        },
        {
          "id": "it_focused",
          "if": { "field": "role", "op": "eq", "value": "it" },
          "headline": "Sorter WMS Integration",
          "body": [
            "Под ваш набор интеграций подойдёт сборка с открытым API и брокером событий.",
            "Коннекторы к типовым системам входят в тариф, кастомные пишем в рамках внедрения."
          ],
          "highlights": [
            { "label": "Тариф", "value": "Integration" },
            { "label": "Срок внедрения", "value": "6–8 недель" },
            { "label": "Интеграции", "value": "Открытый API + брокер событий" }
          ]
        },
        {
          "id": "standard",
          "headline": "Sorter WMS Standard",
          "body": [
            "Для вашего профиля достаточно стандартной облачной поставки.",
            "Типовой запуск занимает 4–6 недель и не требует изменений в ИТ-инфраструктуре."
          ],
          "highlights": [
            { "label": "Тариф", "value": "Standard" },
            { "label": "Срок внедрения", "value": "4–6 недель" },
            { "label": "Модель поставки", "value": "Облако" }
          ]
        }
      ]
    }
  ],
  "variants": {
    "B": {
      "overrides": {
        "intro": {
          "title": "Покажем Sorter WMS на вашем складе",
          "subtitle": "Шесть вопросов — и подберём сценарий демо",
          "ctaLabel": "Подобрать демо"
        },
        "result": {
          "title": "Готово — предлагаем следующий шаг",
          "ctaLabel": "Записаться на демо",
          "secondaryCtaLabel": "Прислать описание на почту"
        }
      }
    }
  }
}
